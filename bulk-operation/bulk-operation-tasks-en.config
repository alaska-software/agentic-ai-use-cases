<?xml version="1.0" encoding="windows-1252"?>
<!--
  Bulk-operation task descriptions for the BulkOperationAgent example. Each
  <task> becomes one natural-language request run through the agent's FSM.
  The <internal> element is metadata for the reader (which classification
  branch and behaviour each task exercises) - the loader ignores it and only
  reads <label> and <text>.

  5 tasks, covering all three classification branches:
    T1 price_change - top-N by revenue, percentage + rounding to nearest 0.50
    T2 other         - discontinue products, supplier + no-order-history filter
    T3 price_change - category-wide percentage reduction, 2-decimal rounding
    T4 stock_order  - stock increase for the lowest-stocked active products
    T5 price_change - flat price override within a price band

  See bulk-operation-tasks-de.config for the identical task set in German -
  same element structure, same order, same five scenarios.
-->
<tasks>

  <!-- T1 -->
  <task>
    <internal>price_change: top-5 price increase by 2025 revenue, rounding to the nearest $0.50. Exercises tool calling and the revenue-impact critic.</internal>
    <label>price-increase-top5</label>
    <text>Increase the unit price of the top 5 best-selling products by revenue in 2025 by 10%. Round each new price to the nearest $0.50.</text>
  </task>

  <!-- T2 -->
  <task>
    <internal>other: discontinue supplier-3 products with no order history at all. No critic block; direct path to review.</internal>
    <label>discontinue-no-orders</label>
    <text>Mark as discontinued (set discontinued = 1) all products supplied by supplier ID 3 that have never appeared in any order in the entire order history.</text>
  </task>

  <!-- T3 -->
  <task>
    <internal>price_change: 15% price reduction for the Seafood category, 2 decimal places. Exercises price-decrease elasticity and the rejection-and-retry path.</internal>
    <label>category-price-reduction</label>
    <text>Reduce the unit price of every product in the Seafood category by 15%. Round each new price to exactly 2 decimal places.</text>
  </task>

  <!-- T4 -->
  <task>
    <internal>stock_order: stock boost for the 5 lowest-stocked active products. Exercises the coverage-months critic.</internal>
    <label>stock-boost-lowest5</label>
    <text>Add 100 units to the unitsinstock of the 5 products with the lowest current stock that are not discontinued (discontinued = 0).</text>
  </task>

  <!-- T5 -->
  <task>
    <internal>price_change: flat price override for products in a price band from supplier 1.</internal>
    <label>flat-price-override</label>
    <text>Set unitprice = 9.99 for all products from supplier ID 1 whose current unitprice is between 10.00 and 12.00 inclusive.</text>
  </task>

</tasks>
