<?xml version="1.0" encoding="windows-1252"?>
<!--
  Aufgabenbeschreibungen (Bulk-Operation) für das BulkOperationAgent-Beispiel,
  identisch zu bulk-operation-tasks-en.config, nur auf Deutsch. Jede <task>
  wird zu einer Anfrage in natürlicher Sprache, die durch die FSM des Agenten
  läuft. Das <internal>-Element ist nur Dokumentation für den Leser (welchen
  Klassifikationszweig und welches Verhalten jede Aufgabe prüft) - der Loader
  ignoriert es und liest nur <label> und <text>.

  5 Aufgaben, decken alle drei Klassifikationszweige ab:
    T1 price_change - Top-N nach Umsatz, Prozent + Rundung auf 0,50
    T2 other         - Produkte einstellen, Lieferant- + Bestellhistorie-Filter
    T3 price_change - kategorieweite prozentuale Senkung, Rundung 2 Dezimalstellen
    T4 stock_order  - Lagerauffüllung für die am wenigsten bevorrateten Produkte
    T5 price_change - pauschale Preisanpassung innerhalb einer Preisspanne

  Gleiche Elementstruktur, gleiche Reihenfolge, gleiche fünf Szenarien wie
  bulk-operation-tasks-en.config.
-->
<tasks>

  <!-- T1 -->
  <task>
    <internal>price_change: Preiserhöhung der Top-5-Produkte nach Umsatz 2025, Rundung auf den nächsten $0,50. Prüft Tool-Aufrufe und den Umsatz-Kritiker.</internal>
    <label>price-increase-top5</label>
    <text>Erhöhe den Stückpreis der 5 umsatzstärksten Produkte nach Erlösen im Jahr 2025 um 10 %. Runde jeden neuen Preis auf den nächsten $0,50.</text>
  </task>

  <!-- T2 -->
  <task>
    <internal>other: Produkte von Lieferant 3 ohne jegliche Bestellhistorie einstellen. Kein Kritiker-Block; direkter Weg zur Freigabe.</internal>
    <label>discontinue-no-orders</label>
    <text>Markiere alle Produkte von Lieferant-ID 3 als eingestellt (setze discontinued = 1), die noch nie in einer Bestellung in der gesamten Bestellhistorie aufgetaucht sind.</text>
  </task>

  <!-- T3 -->
  <task>
    <internal>price_change: 15 % Preissenkung für die Kategorie Seafood, 2 Dezimalstellen. Prüft Preissenkungs-Elastizität und den Ablehnen-und-Wiederholen-Pfad.</internal>
    <label>category-price-reduction</label>
    <text>Reduziere den Stückpreis aller Produkte der Kategorie Seafood um 15 %. Runde jeden neuen Preis auf genau 2 Dezimalstellen.</text>
  </task>

  <!-- T4 -->
  <task>
    <internal>stock_order: Lagerauffüllung für die 5 am wenigsten bevorrateten aktiven Produkte. Prüft den Lagerreichweite-Kritiker.</internal>
    <label>stock-boost-lowest5</label>
    <text>Erhöhe den unitsinstock der 5 Produkte mit dem niedrigsten aktuellen Lagerbestand, die nicht eingestellt sind (discontinued = 0), jeweils um 100 Einheiten.</text>
  </task>

  <!-- T5 -->
  <task>
    <internal>price_change: pauschale Preisanpassung für Produkte innerhalb einer Preisspanne von Lieferant 1.</internal>
    <label>flat-price-override</label>
    <text>Setze unitprice = 9.99 für alle Produkte von Lieferant-ID 1, deren aktueller unitprice zwischen 10.00 und 12.00 liegt (beide Grenzen einschließlich).</text>
  </task>

</tasks>
