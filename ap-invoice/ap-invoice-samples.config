<?xml version="1.0" encoding="windows-1252"?>
<!--
  Invoice samples for the ApInvoiceAgent example (LOB use case - AP Invoice
  Automation). Each <invoice> becomes an InvoiceSource on the blackboard; the
  driver runs the agent for every entry. The <internal> element is metadata for
  the reader (what each scenario exercises) - the loader ignores it and only
  reads <label>, <text> and <imagePath>.

  4 image-based samples  +  2 plain-text samples  =  6 total.
  The four PNG invoices were generated by examples/invoices/generate_invoices.py
  using Arial fonts; each contains all fields the LLM needs to extract.

  Scenarios cover all three terminal outcomes:
    autoPost         - invoice matches PO within tolerance, amount <= 500 threshold
    routeForApproval - invoice matches PO within tolerance, amount > 500 threshold
    raiseException   - duplicate, unknown vendor, hard mismatch

  Demo data (DemoVendorMaster / DemoPurchaseOrderBook):
    V-100 / Acme Corp          / PO-1001 / 1250.00 GBP
    V-101 / Contoso Ltd        / PO-1002 / 3400.00 EUR
    V-102 / Northwind Traders  / PO-1003 /  275.00 EUR
    Posted ledger entry: V-100 / INV-DUP-42  (duplicate detection seed)
    Auto-post threshold: 500.00   Amount tolerance: 0.50
-->
<invoices>

  <!-- 1 — IMAGE -->
  <invoice>
    <internal>AUTO-POST path (image): Northwind Traders, INV-3003, PO-1003, 275.00 EUR. Amount is exactly on the PO total (delta 0.00), within 0.50 tolerance, and below the 500.00 auto-post threshold. Expected terminal: autoPost.</internal>
    <label>sample-autopost</label>
    <text></text>
    <imagePath>invoices\invoice-northwind-autopost.png</imagePath>
  </invoice>

  <!-- 2 — IMAGE -->
  <invoice>
    <internal>ROUTE-FOR-APPROVAL path (image): Contoso Ltd, INV-2002, PO-1002, 3400.00 EUR. Amount matches PO-1002 exactly, within tolerance, but 3400 exceeds the 500.00 auto-post threshold. Expected terminal: routeForApproval (ap-approval-manager, P3).</internal>
    <label>sample-approval</label>
    <text></text>
    <imagePath>invoices\invoice-contoso-approval.png</imagePath>
  </invoice>

  <!-- 3 — IMAGE -->
  <invoice>
    <internal>DUPLICATE path (image): Acme Corp, INV-DUP-42, PO-1001, 1250.00 GBP. INV-DUP-42 is pre-seeded in the posted-invoice ledger for V-100. CheckDuplicate fires before MatchToPO ever runs. Expected terminal: raiseException (duplicate).</internal>
    <label>sample-duplicate</label>
    <text></text>
    <imagePath>invoices\invoice-acme-duplicate.png</imagePath>
  </invoice>

  <!-- 4 — IMAGE -->
  <invoice>
    <internal>HARD-MISMATCH path (image): Northwind Traders, INV-3999, PO-1003, 999.99 EUR. PO-1003 total is 275.00 EUR; delta is 724.99, far beyond the 0.50 tolerance. Expected terminal: raiseException (hard-mismatch).</internal>
    <label>sample-hard-mismatch</label>
    <text></text>
    <imagePath>invoices\invoice-northwind-mismatch.png</imagePath>
  </invoice>

  <!-- 5 — TEXT -->
  <invoice>
    <internal>UNKNOWN-VENDOR path (text): Widgets and Co is not present in the demo vendor master and its bank account is also unrecognised. LookupVendor returns NIL. Expected terminal: raiseException (unknown-vendor).</internal>
    <label>sample-unknown-vendor</label>
    <text>Invoice from Widgets and Co, invoice number INV-WC-001, invoice date 1 Mar 2026, total amount 500.00 USD, bank account 099-FAKE-0000.</text>
    <imagePath></imagePath>
  </invoice>

  <!-- 6 — TEXT -->
  <invoice>
    <internal>ROUTE-FOR-APPROVAL path (text): Acme Corp, INV-1001, PO-1001, 1250.00 GBP. Demonstrates the same approval routing via plain text rather than an image. Amount matches PO-1001, within tolerance, but 1250 exceeds the 500.00 threshold. Expected terminal: routeForApproval (ap-approval-manager, P3).</internal>
    <label>sample-acme-approval</label>
    <text>Invoice from Acme Corp, invoice number INV-1001, purchase order PO-1001, invoice date 5 Mar 2026, total amount 1250.00 GBP, IBAN GB29NWBK60161331926819.</text>
    <imagePath></imagePath>
  </invoice>

<!-- 7 — TEXT -->
<invoice>
  <internal>FUZZY-VENDOR-MATCH path (text): 'Acme Corporation' is a trading-name variant of 'Acme Corp' (V-100). Exact name lookup fails, bank account not provided. LLM proposes V-100. Expected terminal: awaitVendorApproval (human reviews the proposed match before processing continues).</internal>
  <label>sample-fuzzy-vendor</label>
  <text>Invoice from Acme Corporation, invoice number INV-CORP-001, purchase order PO-1001, invoice date 10 Mar 2026, total amount 750.00 GBP.</text>
  <imagePath></imagePath>
</invoice>

</invoices>
