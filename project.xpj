[PROJECT]
    ENCODING=windows-1252
    TARGET_DIR = .\run
    Version = 3.0
    Project.xpj
    RUNENV.FILE = .env
    AUX.FILE = readme.md
    
[project.xpj]
    ap-invoice\ap-invoice-agent.exe
    bulk-operation\bulk-operation.exe

[ap-invoice\ap-invoice-agent.exe]
    COMPILE              = xpp
    COMPILE_FLAGS        = /wi /wl /wu /q /w
    DEBUG                = yes
    GUI                  = no
    LINKER               = alink
    LINK_FLAGS           = 
    RC_COMPILE           = arc
    RC_FLAGS             = 
    INTERMEDIATE_DEBUG   = .debug
    INTERMEDIATE_RELEASE = .release
    TARGET_DIR           = .\.
    DEPENDS_ON           = $(ASSETS_PATH)\agentic-ai-core
    DEPENDS_ON           = $(ASSETS_PATH)\http-streams
    DEPENDS_ON           = $(ASSETS_PATH)\libcurl-wrapper
// $START-AUTODEPEND
    ap-invoice-agent-common.obj
    ap-invoice-agent.obj
    ap-invoice-main.obj
// $STOP-AUTODEPEND
    ap-invoice-agent-common.prg
    ap-invoice-agent.prg
    ap-invoice-main.prg
    ap-invoice-agent-tour.md
    ap-invoice-samples.config

[bulk-operation\bulk-operation.exe]
    COMPILE              = xpp
    COMPILE_FLAGS        = /wi /wl /wu /q /w
    DEBUG                = yes
    GUI                  = no
    LINKER               = alink
    LINK_FLAGS           = 
    RC_COMPILE           = arc
    RC_FLAGS             = 
    INTERMEDIATE_DEBUG   = .debug
    INTERMEDIATE_RELEASE = .release
    TARGET_DIR           = .\.
    DEPENDS_ON           = $(ASSETS_PATH)\agentic-ai-core
    DEPENDS_ON           = $(ASSETS_PATH)\http-streams
    DEPENDS_ON           = $(ASSETS_PATH)\libcurl-wrapper
// $START-AUTODEPEND
// $STOP-AUTODEPEND
    bulk-operation-main.prg
    bulk-operation-common.prg
    bulk-operation-agent.prg
    bulk-operation-tools.prg
    bulk-operation-agent-tour.md
    bulk-operation-tasks-en.config
    bulk-operation-tasks-de.config


